{
    "name":  "teptop",
    "version":  "0.0.4",
    "private":  true,
    "description":  "Teptop.js: a signal-first application runtime built from scratch.",
    "type":  "module",
    "workspaces":  [
                       "packages/teptop",
                       "packages/teptop-cli",
                       "packages/teptop-dom",
                       "packages/teptop-server",
                       "packages/teptop-devtools",
                       "packages/teptop-test-utils",
                       "template/dash-admin"
                   ],
    "scripts":  {
                    "test":  "node --test packages/teptop/test/index.test.js",
                    "test:all":  "node --test packages/teptop/test/*.test.js packages/teptop-cli/test/*.test.js packages/teptop-dom/test/*.test.js packages/teptop-server/test/*.test.js packages/teptop-devtools/test/*.test.js packages/teptop-test-utils/test/*.test.js template/dash-admin/test/*.test.js",
                    "test:watch":  "node --test --watch packages/teptop/test/index.test.js",
                    "test:coverage":  "node --test --experimental-test-coverage packages/teptop/test/*.test.js",
                    "test:security":  "node --test security/security.test.js",
                    "typecheck":  "tsc --noEmit",
                    "check:structure":  "node scripts/structure/report.js",
                    "check:fixtures":  "node --test fixtures/**/*.test.js",
                    "check:compiler":  "node --test compiler/**/*.test.js",
                    "check:root":  "node scripts/verify/root.js",
                    "check:release":  "node scripts/release/check.js",
                    "build:cdn":  "node scripts/cdn/build.js",
                    "demo":  "npm run dev",
                    "cli":  "node packages/teptop-cli/src/cli.js",
                    "dev":  "vite --config vite.config.js --host 127.0.0.1",
                    "build":  "vite build --config vite.config.js",
                    "test:browser":  "playwright test",
                    "demo:admin":  "npm run dev --workspace @teptop/template-dash-admin",
                    "test:browser:admin":  "playwright test --config template/dash-admin/playwright.config.js"
                },
    "engines":  {
                    "node":  "\u003e=20"
                },
    "dependencies":  {

                     },
    "devDependencies":  {
                            "typescript":  "^5.9.2",
                            "jsdom":  "^26.1.0",
                            "vite":  "^7.1.7",
                            "@playwright/test":  "^1.55.0"
                        },
    "license":  "MIT"
}
